NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://macrequire:macrequire@localhost:5432/macrequire?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:4200
# Where unavailable outbound links send users (defaults to the first CORS origin)
FRONTEND_URL=http://localhost:4200
# Number of reverse proxies in front of the API. Local development: leave unset (1). Production: required (see DEPLOY.md).
# TRUST_PROXY_HOPS=2
# Used to salt hashed IPs in click analytics
IP_HASH_SALT=change-me-too
# Initial admin created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@macrequire.local
SEED_ADMIN_PASSWORD=change-me-admin-password
